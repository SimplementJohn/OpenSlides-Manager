# Copie ce fichier en .env et adapte les valeurs. NE COMMITE JAMAIS .env.

# Port de l'API backend
PORT=4000

# Environnement: development | production
NODE_ENV=development

# Secret JWT — OBLIGATOIRE en production. Min 32 caractères aléatoires.
# Génère-en un: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-with-a-long-random-secret-min-32-chars

# Durée de validité du token (ex: 1h, 7d)
JWT_EXPIRES_IN=7d

# Nom du cookie httpOnly portant le token
COOKIE_NAME=osm_token

# Origine autorisée pour CORS (frontend)
CORS_ORIGIN=http://localhost:5173

# Dossier de stockage local des données (hors git)
DATA_DIR=./server/data

# Coût bcrypt (10-14 ; plus haut = plus lent/plus sûr)
BCRYPT_ROUNDS=12
